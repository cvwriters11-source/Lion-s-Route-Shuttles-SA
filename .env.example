# Copy to .env.local and fill in from Supabase Dashboard > Project Settings > API Keys.
# Only the project URL and the publishable (or legacy anon) key belong here.
# Never put the service_role / secret key in any VITE_ variable: it would be shipped to browsers.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
