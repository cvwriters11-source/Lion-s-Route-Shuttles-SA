# Local config for the Vite dev server.
# Copy this file to .env.local in the same folder as package.json.
# .env.local is gitignored. Do not put real keys in this file.
#
# Fill both values from Supabase Dashboard → Project Settings → API Keys:
#   Project URL:       https://<project-ref>.supabase.co
#   Publishable key:   sb_publishable_...   (the legacy anon key also works)
#
# Leave both lines empty until you have those values. Any non-empty pair
# counts as configured, and booking will call that Supabase project.
#
# Never put the service_role / secret key (sb_secret_...) in a VITE_ name.
# Vite ships every VITE_ value to the browser.
#
# Restart `npm run dev` after you edit .env.local. Vite reads env at startup.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
